# Development backend. Set the deployed backend origin in production hosting.
VITE_API_BASE_URL=http://localhost:4000
VITE_API_PREFIX=/trainwellacademy-api
# Optional country detection; leave empty to use India as the default.
VITE_IPINFO_TOKEN=
# Existing backend does not require public configuration endpoints.
BUILD_CONFIG_SOURCE=local
VITE_PUBLIC_CONFIG_SOURCE=local
