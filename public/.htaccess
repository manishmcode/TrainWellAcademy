RewriteEngine On

# Reject guests before Apache serves the private library document. The browser
# sends this session cookie after login; the API still validates the session and
# membership once the member application loads.
RewriteCond %{HTTP:Cookie} !(^|;[[:space:]]*)trainwellacademy_token= [NC]
RewriteRule ^library/?$ /pricing/ [R=307,L,NE]
