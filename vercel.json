{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin", "X-Frame-Options": "SAMEORIGIN", "Permissions-Policy": "camera=(), microphone=(), geolocation=()", "Cache-Control": "public, max-age=0, must-revalidate" }, "continue": true },
    { "src": "/assets/.*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(pricing|unsubscribe|imprint|privacy|terms|privacy-policy|terms-conditions|login|signup|checkout|library|profile|live-classes)/?", "dest": "/$1/index.html" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
